<odoo>
    <record id="sale_order_rma_wizard_form_view" model="ir.ui.view">
        <field name="model">sale.order.rma.wizard</field>
        <field
            name="inherit_id"
            ref="route_planning_rma_sale.sale_order_rma_wizard_form_view"
        />
        <field name="arch" type="xml">
            <field name="reception_route_area_id" position="attributes">
                <attribute
                    name="required"
                >reception_carrier_delivery_type=='route_planning'</attribute>
                <attribute
                    name="invisible"
                    add="reception_carrier_delivery_type != 'route_planning'"
                    separator=" or "
                />
            </field>
        </field>
    </record>
    <record id="sale_order_delivery_rma_wizard_form_view" model="ir.ui.view">
        <field name="model">sale.order.rma.wizard</field>
        <field
            name="inherit_id"
            ref="rma_sale_delivery.sale_order_rma_wizard_form_view"
        />
        <field name="arch" type="xml">
            <field name="reception_carrier_id" position="attributes">
                <attribute name="invisible" add="not operation_id" separator=" or " />
            </field>
        </field>
    </record>
</odoo>
